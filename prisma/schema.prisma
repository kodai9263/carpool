// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 管理者テーブル
model Admin {
  id                      Int      @id @default(autoincrement())
  email                   String   @unique
  supabaseUid             String   @unique
  pendingTransferNewEmail     String?  // 招待中の新担当者メールアドレス
  pendingTransferNewSupabaseUid String? // 招待中の新担当者 Supabase UID
  billingPlan             String   @default("free")
  autoAssignTrialUsed     Int      @default(0)
  stripeCustomerId        String?  @unique
  stripeSubscriptionId    String?  @unique
  stripeSubscriptionStatus String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  teams                   Team[]
  feedbacks               Feedback[]
}

// チームテーブル
model Team {
  id                  Int                   @id @default(autoincrement())
  teamName            String
  teamCode            String                @unique
  memberCount         Int
  adminId             Int
  admin               Admin                 @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  members             Member[]
  rides               Ride[]
  availabilityDrivers AvailabilityDriver[]
  rideSettlements                RideSettlement[]
  settlementAccess               TeamSettlementAccess?
  settlementSubscription         TeamSettlementSubscription?
  settlementCheckoutReservations SettlementCheckoutReservation[]
  settlementSubscriptionEvents   SettlementSubscriptionEvent[]
  settlementBillingConversions   SettlementBillingConversion[]
  viewPinHash         String?
  pin                 String?
  maxGrade            Int                   @default(6)
}

// 家族テーブル
model Member {
  id                  Int                  @id @default(autoincrement())
  teamId              Int
  team                Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  children            Child[]
  guardians           Guardian[]
}

// 保護者テーブル
model Guardian {
  id                  Int                  @id @default(autoincrement())
  name                String               
  memberId            Int                  
  member              Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  availabilityDrivers AvailabilityDriver[]

  @@index([memberId])  // memberId検索用
}

// 子供テーブル
model Child {
  id              Int              @id @default(autoincrement())
  name            String
  grade           Int?
  gradeYear       Int?
  memberId        Int
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rideAssignments RideAssignment[]
  childAvailabilities ChildAvailability[]

  @@index([memberId])  // memberId検索用
}

// 配車テーブル
model Ride {
  id                  Int                  @id @default(autoincrement())
  date                DateTime
  destination         String
  meetingPlace        String?
  deadline            DateTime?
  lockAfterDeadline   Boolean              @default(false)  // true: 回答期限を過ぎたらメンバーの回答をロック
  separateDirections  Boolean              @default(false)  // true: 行き帰り別配車モード
  teamId              Int
  team                Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  rideAssignments     RideAssignment[]
  drivers             Driver[]
  availabilityDrivers AvailabilityDriver[]
  childAvailabilities ChildAvailability[]
  settlement          RideSettlement?

  @@index([teamId, date])  // 日付範囲検索 + チームフィルタ
}

// 配車可能保護者テーブル
model AvailabilityDriver {
  id           Int      @id @default(autoincrement())
  type         String   @default("driver")  // "driver"（配車）| "escort"（引率）
  availability Boolean  @default(false)
  seats        Int      @default(0)         // escort の場合は 0
  direction    String   @default("both")   // "outbound"（行き）| "inbound"（帰り）| "both"（両方）
  comment      String?
  guardianId   Int
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  teamId       Int
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rideId       Int
  ride         Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  driver       Driver[]

  @@unique([rideId, guardianId, type], name: "rideId_guardianId_type")
  @@index([rideId, type])  // typeフィルタ用
}

// 配車実施保護者テーブル
model Driver {
  id                   Int                @id @default(autoincrement())
  type                 String             @default("driver")  // "driver"（配車）| "escort"（引率）
  rideId               Int
  ride                 Ride               @relation(fields: [rideId], references: [id], onDelete: Cascade)
  availabilityDriverId Int
  availabilityDriver   AvailabilityDriver @relation(fields: [availabilityDriverId], references: [id], onDelete: Cascade)
  direction            String             @default("outbound")  // "outbound"（行き）| "inbound"（帰り）
  linkedDriverId       Int?               // 引率者の場合、紐付く配車ドライバーのID
  linkedDriver         Driver?            @relation("EscortLink", fields: [linkedDriverId], references: [id])
  escorts              Driver[]           @relation("EscortLink")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  rideAssignments      RideAssignment[]

  @@unique([rideId, availabilityDriverId, direction])
}

// 乗車子供テーブル
model RideAssignment {
  id        Int      @id @default(autoincrement())
  rideId    Int
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driverId  Int
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  childId   Int
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, childId])
}

// 参加不可子供テーブル
model ChildAvailability {
  id           Int      @id @default(autoincrement())
  availability Boolean  @default(false)  // false = 参加不可
  selfDriving  Boolean  @default(false)  // true = 自走で参加
  childId      Int
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  rideId       Int
  ride         Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([rideId, childId], name: "rideId_childId")
}

// フィードバックテーブル
model Feedback {
  id         Int      @id @default(autoincrement())
  category   String
  message    String
  replyEmail String?
  adminId    Int?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  createdAt  DateTime @default(now())
}

// Checkoutで確定した契約の一次記録。GA送信の成否とは独立して保持する。
model BillingConversion {
  id             Int      @id @default(autoincrement())
  subscriptionId String   @unique
  checkoutId     String   @unique
  adminId        Int
  interval       String?
  source         String
  value          Int
  currency       String
  createdAt      DateTime @default(now())
}
// 1回の配車に紐づく遠征費精算。確定後は元配車が消えても履歴を残す。
model RideSettlement {
  id                    Int                   @id @default(autoincrement())
  teamId                Int
  team                  Team                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  rideId                Int?                  @unique
  ride                  Ride?                 @relation(fields: [rideId], references: [id], onDelete: SetNull)
  sourceDate            DateTime
  sourceDestination     String
  sourceFingerprint     String?
  sourceRideUpdatedAt   DateTime?
  currency              String                @default("JPY")
  status                String                @default("draft")
  version               Int                   @default(0)
  currentRevisionNumber Int?
  draft                 Json?
  voidReason            String?
  createdByAdminId      Int
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  revisions             SettlementRevision[]
  movements             SettlementMovement[]
  freeTrialAccess       TeamSettlementAccess? @relation("FreeTrialSettlement")

  @@index([teamId, status, createdAt])
}

// チームごとに1回だけ使える遠征費精算の無料体験を予約・消費する。
model TeamSettlementAccess {
  id                    Int             @id @default(autoincrement())
  teamId                Int             @unique
  team                  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  freeTrialSettlementId Int?            @unique
  freeTrialSettlement   RideSettlement? @relation("FreeTrialSettlement", fields: [freeTrialSettlementId], references: [id], onDelete: Restrict)
  freeTrialConsumedAt   DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

// 遠征費精算専用のチーム契約。既存の管理者向けPro契約とはStripe顧客を分離する。
model TeamSettlementSubscription {
  id                       Int       @id @default(autoincrement())
  teamId                   Int       @unique
  team                     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  billingAdminId           Int
  billingOwnerSupabaseUid  String
  billingOwnerEmail        String
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?
  stripePriceId            String?
  stripeProductId          String?
  subscriptionStartedAt    DateTime?
  lastStripeEventCreatedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([billingAdminId])
}

// 二重クリックや別タブからの同時申込を1つのCheckoutへまとめる予約。
model SettlementCheckoutReservation {
  id                      Int       @id @default(autoincrement())
  operationKey            String    @unique
  activeKey               String?   @unique
  teamId                  Int
  team                    Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  billingAdminId          Int
  billingOwnerSupabaseUid String
  returnPath              String
  stripeCheckoutSessionId String?   @unique
  status                  String    @default("creating")
  expiresAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([teamId, createdAt])
}

// Webhookの再送・順不同を監査し、現在状態へ反映したかを追記式で残す。
model SettlementSubscriptionEvent {
  id                      Int      @id @default(autoincrement())
  stripeEventId           String   @unique
  eventType               String
  eventCreatedAt          DateTime
  teamId                  Int
  team                    Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  billingAdminId          Int
  billingOwnerSupabaseUid String
  stripeSubscriptionId    String
  stripeStatus            String
  stripePriceId           String
  stripeProductId         String
  applied                 Boolean  @default(false)
  createdAt               DateTime @default(now())

  @@index([teamId, eventCreatedAt])
  @@index([stripeSubscriptionId])
}

// 精算プランの成立済みCheckoutを、画面確認とWebhookの重複から守って1件だけ記録する。
model SettlementBillingConversion {
  id                   Int      @id @default(autoincrement())
  checkoutId           String   @unique
  stripeSubscriptionId String   @unique
  teamId               Int
  team                 Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  billingAdminId       Int
  value                Int
  currency             String
  createdAt            DateTime @default(now())

  @@index([teamId, createdAt])
}

// 確定時点の費用・対象家庭・計算結果を変更不可のスナップショットとして保持する。
model SettlementRevision {
  id                 Int            @id @default(autoincrement())
  settlementId       Int
  settlement         RideSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  revision           Int
  snapshot           Json
  totalAmount        Int
  calculationVersion String         @default("1")
  correctionReason   String?
  createdByAdminId   Int
  createdAt          DateTime       @default(now())

  @@unique([settlementId, revision])
  @@index([settlementId, createdAt])
}

// チーム会計が確認した受領・返金と、その記録ミスの取消を追記式で保持する。
model SettlementMovement {
  id                 Int                 @id @default(autoincrement())
  settlementId       Int
  settlement         RideSettlement      @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  memberIdSnapshot   Int
  memberNameSnapshot String
  signedAmount       Int
  operationKey       String              @unique
  note               String?
  reversesMovementId Int?                @unique
  reversesMovement   SettlementMovement? @relation("MovementReversal", fields: [reversesMovementId], references: [id])
  reversedBy         SettlementMovement? @relation("MovementReversal")
  createdByAdminId   Int
  createdAt          DateTime            @default(now())

  @@index([settlementId, memberIdSnapshot, createdAt])
}
