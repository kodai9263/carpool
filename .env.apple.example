# サーバー専用設定。秘密鍵をEXPO_PUBLIC_やNEXT_PUBLIC_へ設定しない。
# DB移行とApple側の商品・通知設定を完了するまでfalseのままにする。
APPLE_IAP_ENABLED=false
APPLE_IAP_ENVIRONMENT=Production
# 審査・内部検証専用のSupabase UUIDのみ。カンマ区切り、空欄では本番のSandbox受理を無効化。
# 一般ユーザーや実データのあるアカウントは登録しない。アプリの公開変数へ入れない。
APPLE_IAP_SANDBOX_REVIEW_ACCOUNT_TOKENS=
APPLE_BUNDLE_ID=app.carpool.mobile
APPLE_APP_ID=6831953729
APPLE_SUBSCRIPTION_GROUP_ID=22555528
APPLE_PRO_MONTHLY_PRODUCT_ID=app.carpool.mobile.pro.monthly
APPLE_PRO_YEARLY_PRODUCT_ID=app.carpool.mobile.pro.yearly
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# App Store ConnectのIn-App Purchaseキー（P-256）。改行は実改行または\nを使用。
APPLE_IAP_PRIVATE_KEY=
