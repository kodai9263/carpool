{
  "expo": {
    "name": "Carpool Admin",
    "slug": "carpool-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/carpool-logo.png",
    "scheme": "carpool",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/carpool-logo.png",
      "deploymentTarget": "16.4",
      "appleTeamId": "6F83KW7546",
      "bundleIdentifier": "app.carpool.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-iap",
      "./plugins/with-async-storage-resource-target",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/carpool-logo.png",
          "imageWidth": 176
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
